{"at": "2026-11-25T09:46:55.741Z", "run": "20261125-0137-verify-debrid-5636", "unit": "u43", "op": "set", "rid": "debrid/core-ac-uk", "path": "$.limits[0].value", "old": "unauthenticated: 100 tokens per day, maximum 10 per minute, no full text; registered personal user: 1,000 tokens per day, maximum 25 per minute; registered academic user: 5,000 tokens per day, maximum 10 per minute", "new": "unauthenticated: 100 tokens per day, maximum 10 per minute, no full text; registered personal user: 1,000 tokens per day, maximum 25 per minute; registered academic user: 5,000 tokens per day, maximum 10 per minute; Supporting/Sustaining-affiliated academic and non-academic organisation users: about 200k tokens per day on average; VIP: dedicated plan by arrangement", "rung": "documented", "evidence": {"url": "https://api.core.ac.uk/docs/v3", "date": "2026-11-25", "proved": "the v3 reference now publishes a fourth, member-level allowance of about 200k tokens per day", "capture": "sha256:26240c8b97ff6f813270d28bf64019b2cba65b3cf703807c1fdbf866be328dca", "quote": "we estimate this plan should be good for up to about 200k tokens per day"}, "added": true, "reason": "the current v3 rate table adds a Supporting/Sustaining and organisation tier above the three recorded allowances"}
